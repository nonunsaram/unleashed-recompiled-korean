diff --git a/UnleashedRecomp/ui/button_guide.cpp b/UnleashedRecomp/ui/button_guide.cpp
index 6db93d5..20eac53 100644
--- a/UnleashedRecomp/ui/button_guide.cpp
+++ b/UnleashedRecomp/ui/button_guide.cpp
@@ -197,15 +197,24 @@ static void DrawGuide(float* offset, ImVec2 regionMin, ImVec2 regionMax, EButton
     SetScale({ textScale, 1.0f });
     SetOrigin(textPos);
 
+    // Do not force the Korean achievement label through the simulated 720p
+    // pixel grid: resampling its small Hangul strokes makes them look uneven.
+    if (text && strcmp(text, "\xEB\x8F\x84\xEC\xA0\x84\xEA\xB3\xBC\xEC\xA0\x9C") == 0)
+        fontQuality = EFontQuality::High;
+
     if (fontQuality == EFontQuality::Low)
         SetShaderModifier(IMGUI_SHADER_MODIFIER_LOW_QUALITY_TEXT);
 
-    DrawTextWithOutline(g_fntNewRodin, fontSize, textPos, IM_COL32_WHITE, text, 4, IM_COL32_BLACK);
+    const ImU32 guideColor = text && strcmp(text, "도전과제") == 0 ? IM_COL32(224, 224, 220, 255) : IM_COL32_WHITE;
+    DrawTextWithOutline(g_fntNewRodin, fontSize, textPos, guideColor, text, 4, IM_COL32_BLACK);
 
     if (fontQuality == EFontQuality::Low)
     {
         // Add extra luminance to low quality text.
-        drawList->AddText(g_fntNewRodin, fontSize, textPos, IM_COL32(255, 255, 255, 127), text);
+        // The Korean pause label uses the same regular face as the bitmap
+        // confirm guide. A second white pass makes its edges look heavier.
+        if (text && strcmp(text, "\xEB\x8F\x84\xEC\xA0\x84\xEA\xB3\xBC\xEC\xA0\x9C") != 0)
+            drawList->AddText(g_fntNewRodin, fontSize, textPos, IM_COL32(255, 255, 255, 127), text);
         SetShaderModifier(IMGUI_SHADER_MODIFIER_NONE);
     }
 
